# workbench の設定。
#
# **このファイルを写す必要は無い。** capture-ledger の `pnpm run dev:up` が起こすときは、サインインの
# 2 行 (WORKBENCH_OIDC_*) を dev:up が渡し、残りは既定値で動く。手で起こすときだけ、
# `cp -n .env.example .env` で写して、要る行のコメントを外す。
#
# **秘密は 1 つも無い。** 人は IdP (手元は capture-ledger の Floci) のサインインの画面を通り、
# workbench は戻ってきた code をアクセストークンに替えてメモリに持つ。app client は public (secret を
# 持たない)。ここに書くのは「どの IdP か」と「どこを見るか」だけ。
#
# 空文字は「無い」と同じ意味に揃えてある (POSIX の ${VAR:-word} 側)。値を書かない
# なら行ごとコメントにすること。

# workbench の待受。**loopback にだけ bind する。** workbench は台帳のトークンを持つので、
# 届く相手はこの機械の中だけでよい。
#WORKBENCH_PORT=7080

# 台帳の API。host から叩くので loopback —— コンテナの名前は node から届かない
# (macOS 26 は Apple 署名でないバイナリをコンテナの subnet へ通さない)。
#WORKBENCH_LEDGER_URL=http://127.0.0.1:7070

# 人の名乗りの IdP の iss と、workbench の app client の ID。手元は capture-ledger の Floci で、
# プールの ID が iss に入る (Floci を作り直すたびに替わる) ので既定値は無い。capture-ledger の dev:up が
# 引き渡し (capture-ledger の .dev/idp.env の IDP_ISSUER と IDP_WORKBENCH_CLIENT_ID) から渡す。
# 戻り先は http://127.0.0.1:<WORKBENCH_PORT>/callback で、IdP に登録した物と一字一句同じでなければならない
# (capture-ledger の idp:bootstrap は 7080 で登録する)。
# サインインに使う利用者とパスワードも .dev/idp.env に在る (IDP_USER・IDP_USER_PASSWORD)。
# **その利用者の sub に、その組織のクロールの許可が要る**: cd ../capture-ledger && pnpm run idp:grant
#WORKBENCH_OIDC_ISSUER=
#WORKBENCH_OIDC_CLIENT_ID=

# 深いリンクの行き先。workbench が組み立てず、ここで決める。
#WORKBENCH_REPLAYWEB_SERVER_URL=http://127.0.0.1:8899
#WORKBENCH_WINDMILL_URL=http://127.0.0.1:8000
#WORKBENCH_WINDMILL_WORKSPACE=crawler

# WACZ を検証する daemon (wacz-validator)。**鍵を持たない** —— 渡すのは台帳が
# 署名した URL だけで、store の資格情報はどこにも増えない。
#WORKBENCH_VALIDATOR_URL=http://127.0.0.1:7180
