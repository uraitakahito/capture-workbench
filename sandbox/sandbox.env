# サンドボックスの workbench が読む設定。`npm run sandbox` が --env-file で渡す (あなたの .env は読まない)。
#
# 口は capture-ledger の dev:up が起こす workbench (7080)・台帳 (7070)・daemon (7180) と並べて
# 動かせるように、ずらしてある。代役 (17070) と daemon (17180) は docker-compose.yml が
# 127.0.0.1 に出す。代役は開発用 issuer の POST /token にも答えるので、アクセストークンも同じ口から取得する。
WORKBENCH_PORT=7081
WORKBENCH_LEDGER_URL=http://127.0.0.1:17070
WORKBENCH_ISSUER_URL=http://127.0.0.1:17070
WORKBENCH_VALIDATOR_URL=http://127.0.0.1:17180
WORKBENCH_SUBJECT=sandbox
