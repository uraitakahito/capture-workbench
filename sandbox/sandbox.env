# サンドボックスの workbench が読む設定。`npm run sandbox` が --env-file で渡す (あなたの .env は読まない)。
#
# ポートは capture-ledger の dev:up が起こす workbench (7080)・capture-ledger (7070)・daemon (7180) と並べて
# 動かせるように、ずらしてある。代役 (17070) と daemon (17180) は docker-compose.yml が
# 127.0.0.1 に出す。代役は IdP のサインインにも答える (画面を出さずにすぐ戻す) ので、サインインも同じポートで済む。
WORKBENCH_PORT=7081
WORKBENCH_LEDGER_URL=http://127.0.0.1:17070
WORKBENCH_OIDC_ISSUER=http://127.0.0.1:17070/sandbox-pool
WORKBENCH_OIDC_CLIENT_ID=sandbox
WORKBENCH_VALIDATOR_URL=http://127.0.0.1:17180
