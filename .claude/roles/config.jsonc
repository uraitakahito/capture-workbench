// roster（uraitakahito/roster）の担当が push するときの設定。書いていない欄は既定のまま。
{
  // roster push が、push の前に流す確かめ（書き方は roster の docs-site の設定のページの「push の前の確かめ」）。
  // CI（ci.yml・site.yml）の中で、通信に依らず手元で流せる物。
  // 入れない物: vendor（npm ci。通信に依る）・audit・release-version。
  // 要る用意（worktree を作ったら、roster push の前に）: docs-site と highlighter の npm ci。無いと、コードに依らず確かめが落ちる。
  // roster push は origin/main のこの欄を読むので、変えた一覧は merge の後から効く。
  "push": {
    "checks": [
      {
        "name": "check",
        "run": ["npm", "run", "check"],
      },
      {
        "name": "site",
        "run": ["npm", "run", "site:check"],
      },
    ],
  },
}
